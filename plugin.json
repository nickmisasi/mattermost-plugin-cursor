{
    "id": "com.mattermost.plugin-cursor",
    "name": "Cursor Cloud Agents",
    "description": "Manage Cursor Cloud Agents from Mattermost and expose Cursor tools to the Agents plugin via MCP.",
    "homepage_url": "https://github.com/mattermost/mattermost-plugin-cursor",
    "support_url": "https://github.com/mattermost/mattermost-plugin-cursor/issues",
    "icon_path": "assets/cursor-icon.png",
    "min_server_version": "11.3.0",
    "server": {
        "executables": {
            "linux-amd64": "server/dist/plugin-linux-amd64",
            "linux-arm64": "server/dist/plugin-linux-arm64",
            "darwin-amd64": "server/dist/plugin-darwin-amd64",
            "darwin-arm64": "server/dist/plugin-darwin-arm64",
            "windows-amd64": "server/dist/plugin-windows-amd64.exe"
        }
    },
    "webapp": {
        "bundle_path": "webapp/dist/main.js"
    },
    "settings_schema": {
        "header": "Each user connects their own Cursor API key from Cursor Dashboard → Integrations in the Cursor plugin panel.",
        "footer": "",
        "settings": [
            {
                "key": "CursorAPIBaseURL",
                "display_name": "Cursor API Base URL",
                "type": "text",
                "help_text": "Override for testing. Leave empty to use https://api.cursor.com.",
                "default": "",
                "placeholder": "https://api.cursor.com"
            }
        ]
    }
}
